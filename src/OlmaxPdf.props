<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Company>omaximenko</Company>
    <Product>Olmax PDF</Product>
    <Copyright>Copyright © Oleg Maximenko 2026</Copyright>
    <Authors>Oleg Maximenko</Authors>
    <PackageProjectUrl>https://github.com/omaximenko/OlmaxPdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/omaximenko/OlmaxPdf</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>pdf editor modify viewer export</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>