<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\OlmaxPdf.props" />
  <PropertyGroup>
    <Description>Tool to view and perform common modifications to PDFs. Based on PDFium.</Description>
    <Version>2.0.0.0</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>OlmaxPdf.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="PDFiumCore" Version="157.0.8100" />
	</ItemGroup>
</Project>
